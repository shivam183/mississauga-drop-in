# Copy to .env.local to override defaults. Nothing here is secret; the City's
# ActiveNet calendar API needs no key.

# Base URL of the ActiveNet REST API.
# ACTIVENET_BASE_URL=https://anc.ca.apm.activecommunities.com/activemississauga/rest

# Optional User-Agent sent to the City, e.g. so they can identify and contact
# your deployment: "mississauga-drop-in (+https://your-site.example)".
# ACTIVENET_USER_AGENT=
