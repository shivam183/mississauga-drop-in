{
  "name": "mississauga-drop-in",
  "version": "0.0.0",
  "private": true,
  "description": "An unofficial, mobile-friendly way to find drop-in and online-enrollable recreation programs in Mississauga.",
  "license": "MIT",
  "author": "Shivam Sood",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "update-centres": "tsx scripts/update-centres.ts",
    "check-api": "tsx scripts/check-api.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
